# =========================================================================
# Git Ignore Rules for University Multi-Agent RAG System
# =========================================================================

# --- 1. Security & Environment Credentials (NEVER COMMIT) ---
.env
.env.*
*.env
!*.env.example
secrets.json
credentials.json
client_secret*.json
*.pem
*.key
*.cert
*.crt

# --- 2. Local Databases & Student PII Data (NEVER COMMIT) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
university.db
admin.db

# --- 3. Python Bytecode, Caches & Compilations ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- 4. Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- 5. Media, Audio & Upload Recordings ---
*.wav
*.mp3
*.webm
*.ogg
*.m4a
*.flac
temp_audio*
uploads/
tmp/
temp/

# --- 6. Log Files & Diagnostic Outputs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- 7. Test, Coverage & Cache Artifacts ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/

# --- 8. Operating System Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- 9. IDE & Code Editor Configurations ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

