# =========================================================================
# University Multi-Agent RAG System - Environment Template
# 
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your actual private API keys and secrets in .env
# 3. NEVER commit your .env file to public repositories!
# =========================================================================

# Groq Cloud API Configuration (Required for Multi-Agent LLM Reasoning)
# Obtain a free or production key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cryptographic Student Session Secret (HMAC-SHA256)
# Used to sign student session tokens and prevent IDOR / session spoofing.
# Generate a secure key via: python3 -c "import secrets; print(secrets.token_hex(32))"
STUDENT_TOKEN_SECRET=replace_with_a_secure_random_hmac_secret_string_32_chars_min

# Arize Observability & Tracing Configuration (Optional but Recommended)
# Tracks LLM query trajectory, prompt/completion tokens, and execution latency.
# Obtain your key from: https://app.phoenix.arize.com (Settings -> API Keys)
Arize_Key=ak_your_arize_phoenix_api_key_here
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
# PHOENIX_PROJECT_NAME=AgenticRMS-University-Portal

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

